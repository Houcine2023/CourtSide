# Copy to .env (which is git-ignored) and fill in real values.
#   cp .env.example .env
# Never commit .env, and never reuse these placeholder values in production.

# ---- PostgreSQL ----
POSTGRES_DB=courtside
POSTGRES_USER=courtside
POSTGRES_PASSWORD=change-me

# ---- Host port the nginx gateway binds (the only published port) ----
HTTP_PORT=80

# ---- Hostname(s) callers use to reach the site ----
# Angular's SSR server rejects Host headers not on this list (SSRF protection).
# Behind the nginx gateway the browser's Host appears verbatim, so the public
# hostname(s) must be listed here, comma-separated.
#   local test:          localhost
#   deployed to a VM:    courtside.example.com,www.courtside.example.com
SSR_ALLOWED_HOSTS=localhost

# ---- WebSocket origin ----
# The browser opens the /ws socket from the site's own origin; Spring checks it
# against this allowlist (comma-separated origin patterns like http://localhost:*).
#   local test:          http://localhost:*
#   deployed:            https://courtside.example.com
WEBSOCKET_ORIGINS=http://localhost:*

# ---- JWT signing key ----
# HMAC-SHA256 needs >= 32 bytes. Generate one with:
#   openssl rand -base64 48
# or in PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes
